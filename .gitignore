# Secrets — API keys live here, never committed
.env
.env.*

# Retrieved data (timestamped pulls; regenerate, don't version)
# NOTE: "data/*" (not bare "data/") is deliberate — git cannot re-include files inside a
# directory excluded via a bare trailing-slash pattern (documented gitignore behavior:
# "It is not possible to re-include a file if a parent directory of that file is
# excluded"), so the negations below would silently no-op against a bare "data/". Verified
# with `git check-ignore -v`.
data/*

# data/* above still ignores data/portfolio/positions.json (and everything else under
# data/) by default. Re-include the dir, re-block its contents, then un-ignore only the
# two committed template files:
!data/portfolio/
data/portfolio/*
!data/portfolio/positions.example.json
!data/portfolio/README.md

# data/heroes/manifest.json — committed provenance for the hero-image
# placeholders/brand assets (see scripts/aiinvest/heroes.py); same
# re-include dance as data/portfolio/ above (bare "data/heroes/" would
# not re-include files already excluded by the parent "data/*").
!data/heroes/
data/heroes/*
!data/heroes/manifest.json

# Playwright MCP scratch
.playwright-mcp/

# Generated capital-web artifacts (regenerate: python scripts/build_capital_web.py)
capital_web.html
capital_web_render.png

# The Daily Screen — daily_post.py's finished-folder output + verdict-snapshot/
# posted-log history (data/halal_history/ is also covered by "data/*" above;
# listed explicitly for clarity alongside higgs/daily/). remotion/public/daily/
# holds the WAV copies daily_post.py's align step writes for Remotion's
# `voiceSrc` -- they legitimately stay after a successful run (re-renders reuse
# them), so this is a blanket ignore rather than a per-post cleanup.
higgs/daily/
data/halal_history/
remotion/public/daily/

# Generated analyst/dashboard artifacts + scratch
*_dashboard.html
stack_screener.html
*_render.png
gf_*.txt
# Root-level screenshots & scratch (verification artifacts; regenerable)
/*.png
/series_all.json
.vercel/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Next.js site (web/) build + deps
web/node_modules/
web/.next/
web/out/
site_*.png

# Portfolio module — server-only computed bundle (NOT public/, never gated-bypass-able;
# see docs/superpowers/specs/2026-07-15-portfolio-design.md §0)
web/data/

# Generated web data bundles (produced by scripts/refresh_*.py + pull/build_*.py on the
# owner's machine; sandbox copies are synthetic fixtures — never version either kind).
# Needed explicitly since "data/*" above is root-anchored and no longer covers this dir.
web/public/data/

# Local secrets dir — API keys live here, never committed
.secrets/
studio/.claude/

# The reference recording the toon style was derived from — someone else's
# content, kept locally for comparison, never committed.
Enregistrement*.mp4
example.mp4
