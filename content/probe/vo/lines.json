[
 {
  "n": 1,
  "frame": 14,
  "text": "Twenty point nine million barrels cross a single strait every day. About a fifth of the oil the world burns.",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3EcHFV4fsIm7E71S9njiQ0O2FLR/hf_20260801_214846_6ccdd7f7-9bcc-4aad-8b38-ac9c874a4efd.wav"
 },
 {
  "n": 2,
  "frame": 246,
  "text": "Friday the twenty-seventh. Brent settles at seventy-two.",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3EcHFV4fsIm7E71S9njiQ0O2FLR/hf_20260801_214850_62de5441-86b1-4148-8c75-c103ea12669a.wav"
 },
 {
  "n": 3,
  "frame": 362,
  "text": "Then it happens on a Saturday. Markets are closed.",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3EcHFV4fsIm7E71S9njiQ0O2FLR/hf_20260801_215006_239b4747-8ff6-4534-a404-b8b74a209064.wav"
 },
 {
  "n": 4,
  "frame": 464,
  "text": "Monday opens four fifty-two higher.",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3EcHFV4fsIm7E71S9njiQ0O2FLR/hf_20260801_215244_0e1ddeeb-57c2-4831-a4f8-a2bc01331038.wav"
 },
 {
  "n": 5,
  "frame": 598,
  "text": "It runs to eighty-two, then closes four under. Whoever chased bought the high.",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3EcHFV4fsIm7E71S9njiQ0O2FLR/hf_20260801_215117_ac8b30f2-3871-43b4-82fd-3cd345135120.wav"
 },
 {
  "n": 6,
  "frame": 802,
  "text": "One day, sitting entirely inside the day before.",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3EcHFV4fsIm7E71S9njiQ0O2FLR/hf_20260801_215248_9f9ae1cf-6510-435b-a2db-0e92d686e2b4.wav"
 },
 {
  "n": 7,
  "frame": 908,
  "text": "The trigger is a close above that range, with the stop under the coil.",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3EcHFV4fsIm7E71S9njiQ0O2FLR/hf_20260801_215458_cd95325b-9f43-43c3-b6cc-8e71d3a69fe2.wav"
 },
 {
  "n": 8,
  "frame": 1040,
  "text": "Target: twice the risk.",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3EcHFV4fsIm7E71S9njiQ0O2FLR/hf_20260801_215419_acbb89f9-ee09-44ec-90b2-bb59afd2d0d2.wav"
 },
 {
  "n": 9,
  "frame": 1154,
  "text": "Then it unwinds, seventy dollars by July.",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3EcHFV4fsIm7E71S9njiQ0O2FLR/hf_20260801_215727_561ceac8-3a0f-438d-aefd-9ca7b49151ba.wav"
 },
 {
  "n": 10,
  "frame": 1244,
  "text": "That setup fired seventeen times in two years, and reached target four.",
  "url": "https://d8j0ntlcm91z4.cloudfront.net/user_3EcHFV4fsIm7E71S9njiQ0O2FLR/hf_20260801_215543_19f06162-c697-4d97-9d75-942605bd0971.wav"
 }
]