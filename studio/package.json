{
  "name": "ai-stack-studio",
  "version": "0.1.0",
  "description": "Local content cockpit for AI STACK reels/posts",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
